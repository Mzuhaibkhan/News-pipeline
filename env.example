# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_user:your_password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database and collection names (defaults shown)
MONGO_DB_NAME=news_pipeline
MONGO_COLLECTION=articles
MONGO_SUBSCRIBERS_COLLECTION=subscribers

# SMTP Email Configuration (Required for sending newsletter emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=News Pipeline Digest <your_email@gmail.com>

# News source API keys (at least one is required — RSS feeds work without keys)
NEWSAPI_KEY=your_newsapi_key_here
GUARDIAN_KEY=your_guardian_api_key_here
TIINGO_KEY=your_tiingo_key_here
MARKETAUX_KEY=your_marketaux_key_here
STOCK_NEWS_KEY=your_stock_news_key_here
APITUBE_KEY=your_apitube_key_here
GNEWS_KEY=your_gnews_key_here
FINNHUB_KEY=your_finnhub_key_here
INDIANAPI_KEY=your_indianapi_key_here
NEWSDATA_KEY=your_newsdata_key_here

# Redis URL for Distributed Caching & Rate Limiting
# ⚠️  CRITICAL for production: without Redis each Gunicorn worker runs its own
#    in-memory cache, multiplying MongoDB load by the worker count and breaking
#    cross-worker cache invalidation. Set this for any multi-worker deployment.
# Format: redis://[[username]:password@]host[:port][/database]
# Example: redis://localhost:6379/0
REDIS_URL=

# API Authentication Key
# Set this to protect admin endpoints (fetch, cleanup, newsletter, subscribers).
# Clients must send this value in the X-Api-Key header.
# If left empty, all admin endpoints are unprotected (dev mode).
API_SECRET_KEY=

# CORS Allowed Origins (comma-separated list of frontend domains)
# Required if a browser-based frontend will consume this API.
# Example: https://yourdomain.com,https://app.yourdomain.com
# Leave empty to disable CORS headers (backend-only usage).
CORS_ALLOWED_ORIGINS=

# Article Time-To-Live — MongoDB TTL index auto-deletes articles older than
# this many days. Default: 0 (disabled — articles persist indefinitely).
ARTICLE_TTL_DAYS=0

# Secret key for signing newsletter unsubscribe tokens (HMAC).
# If unset, falls back to API_SECRET_KEY. Must be set for secure unsubscribe links.
TOKEN_SECRET_KEY=

# Base URL for generating 1-click unsubscribe links in newsletter emails.
# Example: https://api.yourdomain.com
# If unset, unsubscribe links will use relative paths.
UNSUBSCRIBE_BASE_URL=
